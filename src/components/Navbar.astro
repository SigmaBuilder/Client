---
import ThemeToggle from './ThemeToggle.tsx';
---

<header
  class="
    sticky top-0 z-50
    bg-background/30 backdrop-blur-xl border-b border-border/20
  "
>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 md:px-6">
    <a
      href="/"
      class="flex items-center gap-2 font-bold text-foreground text-lg md:text-xl tracking-tight"
      aria-label="SigmaBuilder — Ir al inicio"
    >
      <span class="text-primary">Σ</span>
      <span>SigmaBuilder</span>
    </a>

    <div class="flex items-center gap-1 md:gap-2">
      <ThemeToggle client:load />
    </div>
  </div>
</header>