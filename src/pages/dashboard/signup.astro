---
import AuthLayout from '@/layouts/AuthLayout.astro';
import { SignupForm } from '@/components/signup-form';
---

<AuthLayout title="Registrarse | SigmaBuilder" description="Crea tu cuenta en SigmaBuilder para empezar a construir proyectos dinámicos.">
  <div class="flex min-h-svh w-full items-center justify-center p-6 md:p-10 bg-muted/50">
    <div class="w-full max-w-4xl">
      <SignupForm client:load />
    </div>
  </div>
</AuthLayout>
