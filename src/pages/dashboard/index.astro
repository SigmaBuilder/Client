---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { ModeToggle } from '@/components/shared/ThemeToggle';
---

<DashboardLayout title="Dashboard | SigmaBuilder">
  <div class="flex min-h-screen flex-col">
    <header class="sticky top-0 z-50 w-full border-b bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60">
      <div class="flex h-14 items-center justify-between px-4 md:px-6">
        <div class="flex items-center gap-2">
          <img src="/dark-icon.svg" alt="SigmaBuilder Logo" class="h-6 w-6 dark:hidden" />
          <img src="/icon.svg" alt="SigmaBuilder Logo" class="h-6 w-6 hidden dark:block" />
          <span class="font-semibold">Dashboard</span>
        </div>
        <ModeToggle client:load />
      </div>
    </header>
    <main class="flex-1 p-4 md:p-6">
      <div class="mx-auto max-w-7xl">
        <h1 class="text-2xl font-bold tracking-tight">Bienvenido al Dashboard</h1>
        <p class="mt-2 text-muted-foreground">
          Aquí podrás gestionar tus proyectos y configuraciones.
        </p>
      </div>
    </main>
  </div>
</DashboardLayout>
