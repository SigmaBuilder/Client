---
import BaseLayout from './BaseLayout.astro'
import Navbar from '@/components/landing/Navbar.astro'
import Footer from '@/components/shared/Footer.astro'

interface Props {
  title?: string
  description?: string
  ogImage?: string
}

const {
  title = 'SigmaBuilder',
  description = 'SigmaBuilder es la plataforma SaaS que te permite crear proyectos dinámicos y añadir tus propios modales y estructuras personalizadas. Empieza gratis.',
  ogImage = '/og-image.png',
} = Astro.props;
---

<BaseLayout {title} {description} {ogImage}>
  <div class="relative min-h-screen">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 inset-x-0 h-[800px] -z-10"
      style="
        background: radial-gradient(
          ellipse 90% 60% at 50% -10%,
          oklch(0.546 0.245 262.9 / 22%) 0%,
          transparent 80%
        );
      "
    ></div>
    <Navbar />
    <slot />
    <Footer />
  </div>
</BaseLayout>
