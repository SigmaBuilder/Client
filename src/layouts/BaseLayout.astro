---
import '@/styles/global.css'
import ThemeScript from '@/components/shared/ThemeScript.astro'

interface Props {
  title?: string
  description?: string
  ogImage?: string
  lang?: string
}

const {
  title = 'SigmaBuilder',
  description = 'SigmaBuilder es la plataforma SaaS que te permite crear proyectos dinámicos y añadir tus propios modales y estructuras personalizadas.',
  ogImage = '/og-image.png',
  lang = 'en',
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="icon" type="image/svg+xml" href="/light-icon.svg?v=2" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="SigmaBuilder" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <ThemeScript />
  </head>
  <body class="min-h-screen bg-background font-sans text-foreground antialiased">
    <slot />
  </body>
</html>
