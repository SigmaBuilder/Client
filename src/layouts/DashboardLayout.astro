---
import BaseLayout from './BaseLayout.astro'

interface Props {
  title?: string
  description?: string
}

const {
  title = 'Dashboard | SigmaBuilder',
  description = 'Panel de control de SigmaBuilder.',
} = Astro.props;
---

<BaseLayout {title} {description}>
  <div class="min-h-screen bg-background">
    <slot />
  </div>
</BaseLayout>
